#!/bin/sh
# postinst (opkg/apk): Dienst aktivieren und (ausser im Image-Build, also wenn
# IPKG_INSTROOT gesetzt ist) gleich (neu) starten - restart statt start,
# damit nach einem Upgrade nicht der alte Code weiterlaeuft.
[ -n "$IPKG_INSTROOT" ] && exit 0

/etc/init.d/mesh-roaming enable
/etc/init.d/mesh-roaming restart

exit 0
