#!/bin/sh /etc/rc.common
# Live-Dienst fuer ein OpenWrt-Mesh-Netzwerk (usteer) - Karte, Roaming-Log,
# Kanalauslastung. Siehe https://github.com/benni78/mesh-roaming-dashboard
# Version 2.1 (MESH_ROAMING_VERSION)
# Copyright Benjamin Johann (mesh-roaming-dashboard)
# SPDX-License-Identifier: PolyForm-Noncommercial-1.0.0
#
# Konfiguration kommt entweder direkt aus /etc/mesh-roaming/config.json
# (von Hand gepflegt) oder - falls installiert - aus UCI
# (/etc/config/mesh-roaming, z. B. ueber luci-app-mesh-roaming bearbeitet).
# Ist eine UCI-Konfiguration mit einer "config global"-Sektion vorhanden,
# wird vor jedem Start/Reload daraus frisch die config.json erzeugt; sonst
# bleibt eine vorhandene config.json unangetastet.

USE_PROCD=1
START=95
STOP=10

PROG=/usr/bin/python3
SCRIPT=/usr/share/mesh-roaming/mesh_roaming_pi.py
CONFIG_JSON=/etc/mesh-roaming/config.json
UCI2JSON=/usr/libexec/mesh-roaming-uci2json
ADD_LOCAL=/usr/libexec/mesh-roaming-add-local-router

regenerate_config_from_uci() {
	[ -x "$UCI2JSON" ] || return 0
	[ -f /etc/config/mesh-roaming ] || return 0
	"$UCI2JSON" --out "$CONFIG_JSON"
	# Exit-Code 2 = keine "config global"-Sektion -> absichtlich kein
	# Fehler, die vorhandene config.json bleibt einfach bestehen.
}

# true, wenn config.json gueltiges JSON ist, aber keinen Router enthaelt
# (z. B. frisch installiert, noch nichts in LuCI eingetragen). Dann den
# Dienst gar nicht erst starten - sonst beendet sich Python sofort und procd
# startet es (respawn) alle 5 Sekunden neu, jedes Mal mit Fehler im Log.
# Andere Konfigurationsfehler meldet weiterhin Python selbst.
config_has_no_routers() {
	[ -f "$CONFIG_JSON" ] || return 1
	jsonfilter -i "$CONFIG_JSON" -e '@' >/dev/null 2>&1 || return 1
	! jsonfilter -i "$CONFIG_JSON" -e '@.routers[0]' >/dev/null 2>&1
}

start_service() {
	# Ohne einen einzigen Router den eigenen als Standard eintragen (#8)
	[ -x "$ADD_LOCAL" ] && "$ADD_LOCAL"
	regenerate_config_from_uci

	mkdir -p /etc/mesh-roaming

	if config_has_no_routers; then
		logger -t mesh-roaming "Keine Router konfiguriert ($CONFIG_JSON) - Dienst wird nicht gestartet. Router in LuCI (Dienste > Mesh Roaming Dashboard > Router) oder in der config.json eintragen."
		return 0
	fi

	procd_open_instance
	procd_set_param command "$PROG" "$SCRIPT"
	procd_set_param env MESH_ROAMING_CONFIG="$CONFIG_JSON"
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param pidfile /var/run/mesh-roaming.pid
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "mesh-roaming"
}

reload_service() {
	stop 2>/dev/null
	start
}
