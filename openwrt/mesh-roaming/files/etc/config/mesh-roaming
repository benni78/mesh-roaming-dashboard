
config global 'main'
	option label 'Mesh-Netzwerk'
	option bind '0.0.0.0'
	option port '8765'
	option interval_sec '1'
	option db_path '/etc/mesh-roaming/state.db'
	option runtime_dir '/etc/mesh-roaming/run'
	option ssh_user 'root'
	option ssh_key_path '/etc/mesh-roaming/id_ed25519'
	option ssh_connect_timeout_sec '5'
	option ssh_command_timeout_sec '8'
	option ssh_control_master '1'
	option ssh_control_persist '60s'
	list ap_ifname 'phy0-ap0'
	list ap_ifname 'phy0-ap1'
	list ap_ifname 'phy0-ap2'
	list ap_ifname 'phy0-ap3'
	list ap_ifname 'phy1-ap0'
	list ap_ifname 'phy1-ap1'
	list ap_ifname 'phy1-ap2'
	list ap_ifname 'phy1-ap3'
	option retention_days '7'
	option anonymous_stats_enabled '1'
	option reachable_signal_threshold_dbm '-75'
	option shift_amount_min '0.15'
	option shift_amount_max '0.70'
	option log_max_entries '200'
	option signal_min_dbm '-90'
	option signal_max_dbm '-30'
	list reference_ring_dbm '-55'
	list reference_ring_dbm '-70'
	list reference_ring_dbm '-90'
	option map_viewbox_width '900'
	option map_viewbox_height '600'
	option map_radius_inner '16'
	option map_radius_outer '100'
	list ssid_color '#5b8dd6'
	list ssid_color '#d6905b'
	list ssid_color '#7fbf6b'
	list ssid_color '#b06bbf'
	list ssid_color '#5bb0b0'
	list ssid_color '#c2b95a'
	option util_interval_sec '10'
	option util_color_own '#3987e5'
	option util_color_foreign '#e66767'
	option util_color_rest '#2f3d46'
	option mqtt_broker ''
	option mqtt_base_topic 'mesh-roaming'
	option mqtt_publish_interval_sec '10'
