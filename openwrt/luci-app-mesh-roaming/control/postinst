#!/bin/sh
# opkg postinst: rpcd neu laden, damit die neue ACL sofort greift, und ggf.
# den LuCI-Cache leeren, damit das neue Menue sofort sichtbar ist.
[ -n "$IPKG_INSTROOT" ] && exit 0

[ -x /etc/init.d/rpcd ] && /etc/init.d/rpcd reload >/dev/null 2>&1

rm -f /tmp/luci-indexcache /tmp/luci-modulecache/* 2>/dev/null

exit 0
